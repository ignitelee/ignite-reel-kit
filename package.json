{
  "name": "ignite-reel-kit",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "IGNITE Reel Kit: turn talking-head videos into branded, captioned reels with Claude Code. Built on Nate Herk's HyperFrames student kit.",
  "scripts": {
    "doctor": "node scripts/reel-doctor.mjs",
    "dashboard": "node dashboard/server.mjs",
    "shortcut": "node scripts/make-shortcut.mjs",
    "transcribe": "node scripts/transcribe.mjs",
    "new-reel": "node scripts/new-reel.mjs",
    "build-reel": "node scripts/build-reel.mjs",
    "render-reel": "node scripts/render-reel.mjs",
    "validate-beats": "node scripts/validate-beat-sync.mjs",
    "preflight": "node scripts/preflight.mjs",
    "sync:skills": "node scripts/sync-codex-skills.mjs",
    "check:skills": "node scripts/sync-codex-skills.mjs --check",
    "setup": "node scripts/setup.mjs",
    "new-video": "node scripts/new-video.mjs",
    "demo": "node scripts/new-video.mjs demo",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-kit.mjs",
    "catalog": "node scripts/style-library/build-registry.mjs",
    "test:media": "node scripts/smoke-media.mjs",
    "validate:short-form": "node .claude/skills/short-form-edit/scripts/validate-plan.mjs",
    "validate:footage": "node .claude/skills/short-form-edit/scripts/validate-footage.mjs",
    "preflight:all": "node scripts/preflight-all.mjs",
    "transcribe:elevenlabs": "node scripts/transcribe-elevenlabs.mjs",
    "logo": "node scripts/find-logo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.7.109",
    "playwright": "^1.59.1"
  },
  "dependencies": {
    "simple-icons": "16.35.0"
  },
  "allowScripts": {
    "esbuild": true,
    "onnxruntime-node": false,
    "protobufjs": false,
    "@google/genai": false
  }
}
